{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "OCMS6.1 Offence Evidence View and Download",
    "locale": "en",
    "output": "OCMS6.1.html",
    "viewBox": [
      1080,
      620
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "staff",
      "type": "external",
      "label": "Notice Officer",
      "sublabel": "Staff portal user"
    },
    {
      "id": "ui",
      "type": "frontend",
      "label": "Staff Portal UI",
      "sublabel": "ocmsadminui"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "Admin API",
      "sublabel": "ocmsadminapi"
    },
    {
      "id": "cron",
      "type": "backend",
      "label": "CES Cron",
      "sublabel": "ocmsadminprivateapi"
    },
    {
      "id": "db",
      "type": "database",
      "label": "Attachment DB",
      "sublabel": "ocms_offence_attachment"
    },
    {
      "id": "blob",
      "type": "database",
      "label": "Azure Blob",
      "sublabel": "notice attachments"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 210,
      "label": "Ingest"
    },
    {
      "from": 212,
      "to": 360,
      "label": "List"
    },
    {
      "from": 362,
      "to": 510,
      "label": "View / Download"
    }
  ],
  "messages": [
    {
      "id": "m0",
      "from": "cron",
      "to": "blob",
      "y": 165,
      "label": "Daily 07:00: upload source bytes (photo only)",
      "variant": "dashed"
    },
    {
      "id": "m1",
      "from": "cron",
      "to": "db",
      "y": 195,
      "label": "Insert attachment row (mime, size)",
      "variant": "dashed"
    },
    {
      "id": "m2",
      "from": "staff",
      "to": "ui",
      "y": 225,
      "label": "Open notice, Offence Details tab",
      "variant": "default"
    },
    {
      "id": "m3",
      "from": "ui",
      "to": "api",
      "y": 255,
      "label": "POST offenceattachmentlist {noticeNo}",
      "variant": "emphasis"
    },
    {
      "id": "m4",
      "from": "api",
      "to": "db",
      "y": 285,
      "label": "Read attachment rows",
      "variant": "dashed"
    },
    {
      "id": "m5",
      "from": "api",
      "to": "ui",
      "y": 315,
      "label": "File list (name, mime, size)",
      "variant": "return"
    },
    {
      "id": "m6",
      "from": "ui",
      "to": "staff",
      "y": 345,
      "label": "Photos list and Videos list",
      "variant": "return"
    },
    {
      "id": "m7",
      "from": "staff",
      "to": "ui",
      "y": 375,
      "label": "Preview or Download",
      "variant": "default"
    },
    {
      "id": "m8",
      "from": "ui",
      "to": "api",
      "y": 405,
      "label": "POST downloads {noticeNo, fileName}",
      "variant": "emphasis"
    },
    {
      "id": "m9",
      "from": "api",
      "to": "blob",
      "y": 435,
      "label": "Read blob, no transformation",
      "variant": "dashed"
    },
    {
      "id": "m10",
      "from": "api",
      "to": "ui",
      "y": 465,
      "label": "Raw bytes (octet-stream)",
      "variant": "return"
    },
    {
      "id": "m11",
      "from": "ui",
      "to": "staff",
      "y": 495,
      "label": "Image preview; video: save only",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "ui",
      "from": 220,
      "to": 500,
      "type": "frontend"
    },
    {
      "participant": "api",
      "from": 250,
      "to": 470,
      "type": "backend"
    },
    {
      "participant": "cron",
      "from": 160,
      "to": 200,
      "type": "backend"
    },
    {
      "participant": "db",
      "from": 190,
      "to": 290,
      "type": "database"
    },
    {
      "participant": "blob",
      "from": 160,
      "to": 440,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Matches story",
      "items": [
        "Photos stored as source bytes",
        "Single file download is raw bytes",
        "Zip of all photos or videos"
      ]
    },
    {
      "dot": "rose",
      "title": "Gap",
      "items": [
        "No video player in staff portal",
        "No automatic video ingest in repo",
        "Undecodable photos never stored"
      ]
    },
    {
      "dot": "orange",
      "title": "To verify",
      "items": [
        "Blob retention policy",
        "Content of historical PRD blobs",
        "REP CCS media availability"
      ]
    }
  ]
}
