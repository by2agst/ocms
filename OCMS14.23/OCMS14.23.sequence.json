{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "OCMS14.23 Daily Classified Vehicle Report",
    "locale": "en",
    "output": "OCMS14.23.html",
    "viewBox": [
      1080,
      620
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "cron",
      "type": "backend",
      "label": "Daily Report cron",
      "sublabel": "08:00 job 7"
    },
    {
      "id": "job",
      "type": "backend",
      "label": "Report Job",
      "sublabel": "ClassifiedVehicleReportJob"
    },
    {
      "id": "db",
      "type": "database",
      "label": "VON table",
      "sublabel": "ocms_valid_offence_notice"
    },
    {
      "id": "mail",
      "type": "external",
      "label": "Email Service",
      "sublabel": "SMTP gate"
    },
    {
      "id": "oic",
      "type": "external",
      "label": "OIC",
      "sublabel": "Dashboard or inbox"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 270,
      "label": "Select data"
    },
    {
      "from": 272,
      "to": 340,
      "label": "Build file"
    },
    {
      "from": 342,
      "to": 500,
      "label": "Delivery"
    }
  ],
  "messages": [
    {
      "id": "m0",
      "from": "cron",
      "to": "job",
      "y": 165,
      "label": "Run job 7 daily",
      "variant": "default"
    },
    {
      "id": "m1",
      "from": "job",
      "to": "db",
      "y": 195,
      "label": "All type V notices, no date filter",
      "variant": "emphasis"
    },
    {
      "id": "m2",
      "from": "db",
      "to": "job",
      "y": 225,
      "label": "Vehicle, offence time, code, car park, amount",
      "variant": "return"
    },
    {
      "id": "m3",
      "from": "job",
      "to": "db",
      "y": 255,
      "label": "Notices amended V to S",
      "variant": "dashed"
    },
    {
      "id": "m4",
      "from": "job",
      "to": "mail",
      "y": 355,
      "label": "sendEmail Excel, no source",
      "variant": "emphasis"
    },
    {
      "id": "m5",
      "from": "mail",
      "to": "job",
      "y": 395,
      "label": "enableSmtp=false: false",
      "variant": "return"
    },
    {
      "id": "m6",
      "from": "job",
      "to": "cron",
      "y": 435,
      "label": "Job FAILED, failure mail blocked",
      "variant": "return"
    },
    {
      "id": "m7",
      "from": "mail",
      "to": "oic",
      "y": 480,
      "label": "No owner/driver name, no dashboard",
      "variant": "dashed"
    }
  ],
  "activations": [
    {
      "participant": "job",
      "from": 160,
      "to": 440,
      "type": "backend"
    },
    {
      "participant": "db",
      "from": 190,
      "to": 260,
      "type": "database"
    },
    {
      "participant": "mail",
      "from": 350,
      "to": 480,
      "type": "external"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Matches story",
      "items": [
        "Daily 08:00 job exists",
        "Vehicle, offence time, car park, amount",
        "Excel file built"
      ]
    },
    {
      "dot": "rose",
      "title": "Gap",
      "items": [
        "No owner or furnished driver name",
        "Emailed, not an OIC dashboard",
        "Prod SMTP blocks this email"
      ]
    },
    {
      "dot": "orange",
      "title": "To verify",
      "items": [
        "Real server SMTP value",
        "Are recipients the OIC",
        "All-time list intended?"
      ]
    }
  ]
}
