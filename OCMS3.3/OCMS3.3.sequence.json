    {
      "id": "m1",
      "from": "ui",
      "to": "api",
      "y": 195,
      "label": "POST /enforcement-report/export",
      "variant": "emphasis"
    },
    {
      "id": "m2",
      "from": "api",
      "to": "von",
      "y": 225,
      "label": "Read notices by creDate + label",
      "variant": "dashed"
    },
    {
      "id": "m3",
      "from": "api",
      "to": "audit",
      "y": 255,
      "label": "Read failed receipts, status 1",
      "variant": "dashed"
    },
    {
      "id": "m4",
      "from": "api",
      "to": "ui",
      "y": 285,
      "label": "Excel: Summary, Success_*, Error_*",
      "variant": "return"
    },
    {
      "id": "m5",
      "from": "ui",
      "to": "oic",
      "y": 315,
      "label": "Download ReportNotice*.xlsx",
      "variant": "return"
    },
    {
      "id": "m6",
      "from": "ui",
      "to": "oic",
      "y": 375,
      "label": "No daily auto-run, no push to OIC",
      "variant": "return"
    },
    {
      "id": "m7",
      "from": "api",
      "to": "ui",
      "y": 405,
      "label": "Rows with no offence type skipped",
      "variant": "return"
    },
    {
      "id": "m8",
      "from": "ui",
      "to": "oic",
      "y": 435,
      "label": "Total can differ from Success + Failed",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "ui",
      "from": 160,
      "to": 440,
