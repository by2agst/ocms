    },
    {
      "participant": "audit",
      "from": 256,
      "to": 266,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Matches story",
      "items": [
        "Report with Summary, per-type sheets, details",
        "Source and date filters, Excel download"
      ]
    },
    {
      "dot": "rose",
      "title": "Gap",
      "items": [
        "No daily scheduled generation",
        "No OIC dashboard routing",
        "Summary tally gap, empty offence type"
