{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "OCMS8.10 Daily ID Exchange Reports",
    "locale": "en",
    "output": "OCMS8.10.html",
    "viewBox": [
      1080,
      620
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "cron",
      "type": "backend",
      "label": "Cron service",
      "sublabel": "ocmsadminprivateapi"
    },
    {
      "id": "dh",
      "type": "external",
      "label": "MHA / DataHive",
      "sublabel": "ID exchange"
    },
    {
      "id": "blob",
      "type": "database",
      "label": "Azure Blob",
      "sublabel": "Excel reports"
    },
    {
      "id": "ui",
      "type": "frontend",
      "label": "Staff Portal",
      "sublabel": "Reports tab"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "Staff API",
      "sublabel": "ocmsadminapi"
    }
  ],
  "segments": [
    {
      "from": 152,
      "to": 268,
      "label": "Run + reports"
    },
    {
      "from": 272,
      "to": 358,
      "label": "Find report"
    },
    {
      "from": 362,
      "to": 418,
      "label": "Download"
    }
  ],
  "messages": [
    {
      "id": "m0",
      "from": "cron",
      "to": "dh",
      "y": 165,
      "label": "Send NRIC / UEN / FIN IDs (Mon-Sat, 3x)",
      "variant": "default"
    },
    {
      "id": "m1",
      "from": "dh",
      "to": "cron",
      "y": 195,
      "label": "Particulars or not found",
      "variant": "return"
    },
    {
      "id": "m2",
      "from": "cron",
      "to": "blob",
      "y": 225,
      "label": "Excel: Summary, Success, Error",
      "variant": "emphasis"
    },
    {
      "id": "m3",
      "from": "cron",
      "to": "blob",
      "y": 255,
      "label": "DH jobs off in PROD file; MHA count 0 (DF-178)",
      "variant": "dashed"
    },
    {
      "id": "m4",
      "from": "ui",
      "to": "api",
      "y": 285,
      "label": "POST daily-report/search (FIN / UEN)",
      "variant": "default"
    },
    {
      "id": "m5",
      "from": "api",
      "to": "blob",
      "y": 315,
      "label": "List DHFIN_ / DHUEN_ files, max 7 days",
      "variant": "dashed"
    },
    {
      "id": "m6",
      "from": "api",
      "to": "ui",
      "y": 345,
      "label": "File list (403 if only DH function)",
      "variant": "return"
    },
    {
      "id": "m7",
      "from": "ui",
      "to": "api",
      "y": 375,
      "label": "POST download/blob",
      "variant": "default"
    },
    {
      "id": "m8",
      "from": "api",
      "to": "ui",
      "y": 405,
      "label": "Excel file",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Matches flow",
      "items": [
        "Sent / not found counts",
        "Exceptions in Error sheet",
        "Report download works"
      ]
    },
    {
      "dot": "rose",
      "title": "Gap",
      "items": [
        "MHA counts zero (DF-178)",
        "No DH function mapping",
        "DH email not sent in PROD"
      ]
    },
    {
      "dot": "orange",
      "title": "To verify",
      "items": [
        "DH job flag in PROD",
        "Role to function assignment",
        "ICA / DOS = MHA / DataHive"
      ]
    }
  ]
}
