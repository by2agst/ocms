{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "OCMS20.20 HST Summary Report for Follow-up",
    "locale": "en",
    "output": "OCMS20.20.html",
    "viewBox": [
      1080,
      620
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "officer",
      "type": "external",
      "label": "Officer",
      "sublabel": "Notice Processing Officer"
    },
    {
      "id": "cron",
      "type": "backend",
      "label": "Cron Service",
      "sublabel": "ocmsadminprivateapi"
    },
    {
      "id": "db",
      "type": "database",
      "label": "Intranet DB",
      "sublabel": "ocms_hst / temp_unc_hst_addr"
    },
    {
      "id": "mha",
      "type": "external",
      "label": "MHA / DataHive",
      "sublabel": "address check"
    },
    {
      "id": "blob",
      "type": "database",
      "label": "Blob Storage",
      "sublabel": "Excel reports"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 270,
      "label": "Monthly check"
    },
    {
      "from": 272,
      "to": 330,
      "label": "Report build"
    },
    {
      "from": 332,
      "to": 430,
      "label": "Officer use"
    }
  ],
  "messages": [
    {
      "id": "m0",
      "from": "cron",
      "to": "db",
      "y": 165,
      "label": "Monthly: queue all HST IDs (adhoc NRO)",
      "variant": "dashed"
    },
    {
      "id": "m1",
      "from": "cron",
      "to": "mha",
      "y": 195,
      "label": "Enquiry file with HST IDs",
      "variant": "default"
    },
    {
      "id": "m2",
      "from": "mha",
      "to": "cron",
      "y": 225,
      "label": "Address results (response date)",
      "variant": "return"
    },
    {
      "id": "m3",
      "from": "cron",
      "to": "db",
      "y": 255,
      "label": "Store in ocms_temp_unc_hst_addr",
      "variant": "dashed"
    },
    {
      "id": "m4",
      "from": "cron",
      "to": "db",
      "y": 285,
      "label": "Daily 08:00: join ocms_hst + results",
      "variant": "dashed"
    },
    {
      "id": "m5",
      "from": "cron",
      "to": "blob",
      "y": 315,
      "label": "Upload Data report + Work Items report",
      "variant": "default"
    },
    {
      "id": "m6",
      "from": "cron",
      "to": "officer",
      "y": 345,
      "label": "Email to OIC (SMTP off in prod)",
      "variant": "return"
    },
    {
      "id": "m7",
      "from": "officer",
      "to": "cron",
      "y": 375,
      "label": "Staff Report > HST page (fields missing)",
      "variant": "default"
    },
    {
      "id": "m8",
      "from": "officer",
      "to": "mha",
      "y": 405,
      "label": "Follow up with ICA/DOS (not in repo)",
      "variant": "default"
    }
  ],
  "activations": [
    {
      "participant": "cron",
      "from": 160,
      "to": 380,
      "type": "backend"
    },
    {
      "participant": "db",
      "from": 160,
      "to": 290,
      "type": "database"
    },
    {
      "participant": "blob",
      "from": 310,
      "to": 320,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Matches story",
      "items": [
        "ID, name, old and new address",
        "MHA/DataHive response date"
      ]
    },
    {
      "dot": "rose",
      "title": "Gap",
      "items": [
        "Email to OIC not sent in prod",
        "Staff HST Reports columns missing",
        "Not tied to setting the indicator"
      ]
    },
    {
      "dot": "orange",
      "title": "To verify",
      "items": [
        "ICA/DOS vs MHA/DataHive",
        "MHA cron status on server"
      ]
    }
  ]
}
