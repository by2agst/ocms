{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "OCMS12.3 Contact Check Before Reminder",
    "locale": "en",
    "output": "OCMS12.3.html",
    "viewBox": [
      1080,
      620
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "off",
      "type": "external",
      "label": "Officer",
      "sublabel": "manual trigger"
    },
    {
      "id": "cron",
      "type": "backend",
      "label": "eNotification job",
      "sublabel": "11:00, disabled"
    },
    {
      "id": "db",
      "type": "database",
      "label": "Intranet DB",
      "sublabel": "VON + owner_driver"
    },
    {
      "id": "dh",
      "type": "external",
      "label": "DataHive",
      "sublabel": "Singpass / Corppass"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 270,
      "label": "Pick"
    },
    {
      "from": 272,
      "to": 345,
      "label": "Refresh"
    },
    {
      "from": 347,
      "to": 510,
      "label": "Validate"
    }
  ],
  "messages": [
    {
      "id": "m0",
      "from": "off",
      "to": "cron",
      "y": 165,
      "label": "POST notification-sms-email/execute",
      "variant": "emphasis"
    },
    {
      "id": "m1",
      "from": "cron",
      "to": "db",
      "y": 205,
      "label": "Pick last stage RD1, in ENOTEDAYS",
      "variant": "dashed"
    },
    {
      "id": "m2",
      "from": "db",
      "to": "cron",
      "y": 245,
      "label": "Notices + stored mobile / email",
      "variant": "return"
    },
    {
      "id": "m3",
      "from": "cron",
      "to": "dh",
      "y": 290,
      "label": "Refresh mobile / email",
      "variant": "dashed"
    },
    {
      "id": "m4",
      "from": "dh",
      "to": "cron",
      "y": 325,
      "label": "Skipped: enareminder.datahive=false",
      "variant": "return"
    },
    {
      "id": "m5",
      "from": "cron",
      "to": "db",
      "y": 370,
      "label": "Skip opt-out and passport owners",
      "variant": "dashed"
    },
    {
      "id": "m6",
      "from": "cron",
      "to": "db",
      "y": 410,
      "label": "Mobile / email missing: skip",
      "variant": "dashed"
    },
    {
      "id": "m7",
      "from": "cron",
      "to": "off",
      "y": 455,
      "label": "Valid contacts go to send step",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Matches flow",
      "items": [
        "RD1 reminders picked",
        "Mobile / email validated",
        "Opt-out, passport skipped"
      ]
    },
    {
      "dot": "rose",
      "title": "Gap",
      "items": [
        "DataHive refresh off",
        "Daily cron disabled",
        "RD1 may be undelivered"
      ]
    },
    {
      "dot": "orange",
      "title": "To verify",
      "items": [
        "DataHive in PROD",
        "Vault access",
        "Epic OCMS9 rules"
      ]
    }
  ]
}
